{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "green-zone",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": true,

  // Daily: refresh any Zillow Research dataset older than ~a month (three per run).
  "triggers": { "crons": ["23 9 * * *"] },

  // Static front end (public/) is served directly; only /api/* runs the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Cloudflare D1: users, sessions, zone types, trips, painted segments, pins.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "green-zone-db",
      "database_id": "5c7ca051-beca-4865-a1a9-f239748a0b8d",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare Email Service: sign-in codes, welcome email and trip summaries.
  // The sender domain (greenzone.swftstudios.com) must be onboarded under Email Service > Email Sending.
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "APP_NAME": "Green Zone",
    "EMAIL_FROM": "login@greenzone.swftstudios.com",
    "EMAIL_FROM_NAME": "Green Zone",
    // Comma-separated emails that are always on the Pro plan (handy for the owner and testers).
    "PRO_EMAILS": "",
    // Must stay empty in production. Set DEV_MODE=1 in .dev.vars to show sign-in codes on screen locally.
    "DEV_MODE": ""
  },

  // Worker Previews (npx wrangler preview / PR builds). Uses the preview D1 database and
  // DEV_MODE so sign-in codes show on screen; does not touch production data.
  // Cron triggers are not applied to Previews.
  "previews": {
    "vars": {
      "APP_NAME": "Green Zone (preview)",
      "EMAIL_FROM": "login@greenzone.swftstudios.com",
      "EMAIL_FROM_NAME": "Green Zone",
      "PRO_EMAILS": "",
      "DEV_MODE": "1"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "green-zone-preview-db",
        "database_id": "c2946a07-1a07-4ba6-96b7-ca875f582efd",
        "migrations_dir": "migrations"
      }
    ],
    "send_email": [{ "name": "EMAIL" }]
  },

  "env": {
    // Persistent demo Worker at green-zone-preview.<subdomain>.workers.dev (`wrangler deploy --env preview`).
    // Distinct from the `previews` block above (branch Worker Previews). Own D1; DEV_MODE shows codes.
    "preview": {
      "workers_dev": true,
      "triggers": { "crons": ["23 9 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "green-zone-preview-db",
          "database_id": "c2946a07-1a07-4ba6-96b7-ca875f582efd",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "APP_NAME": "Green Zone (preview)",
        "EMAIL_FROM": "login@example.com",
        "EMAIL_FROM_NAME": "Green Zone",
        "PRO_EMAILS": "",
        "DEV_MODE": "1"
      }
    }
  }
}
